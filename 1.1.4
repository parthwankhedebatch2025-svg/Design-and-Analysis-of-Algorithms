#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

struct Edge {
    int u, v, w;
};


int compareEdges(const void *a, const void *b) {
    return ((struct Edge *)a)->w - ((struct Edge *)b)->w;
}


int find(int i, int parent[]) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}


void unionSets(int i, int j, int parent[]) {
    int root_i = find(i, parent);
    int root_j = find(j, parent);
    parent[root_i] = root_j;
}

void kruskalMST(int **cost, int V) {


 int maxEdges = (V * (V - 1)) / 2;
    struct Edge *edges = (struct Edge *)malloc(maxEdges * sizeof(struct Edge));
    int edgeCount = 0;

    
    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != 9999) {
                edges[edgeCount].u = i;
                edges[edgeCount].v = j;
                edges[edgeCount].w = cost[i][j];
                edgeCount++;
            }
        }
    }

    
    qsort(edges, edgeCount, sizeof(struct Edge), compareEdges);

   
    int *parent = (int *)malloc(V * sizeof(int));
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int mstEdgesCount = 0;
    int minCost = 0;

    
    for (int i = 0; i < edgeCount && mstEdgesCount < V - 1; i++) {
        int u = edges[i].u;
        int v = edges[i].v;

        
        if (find(u, parent) != find(v, parent)) {
            unionSets(u, v, parent);
            printf("Edge %d:(%d, %d) cost:%d\n", mstEdgesCount, u, v, edges[i].w);
            minCost += edges[i].w;
            mstEdgesCount++;
        }
    }

    printf("Minimum cost= %d\n", minCost);

    
    free(parent);
    free(edges);
}



int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
